{
  "expo": {
    "name": "RealtyContracts",
    "slug": "realty-contracts-mobile",
    "scheme": "realtycontracts",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/Nituv_app_icon.png",

    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.talefraim.realtycontracts",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Nituv_app_icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "8b33aedb-f04c-446b-af8b-69531bcfb335"
      }
    }
  }
}
